# REQUIRED: absolute folder on the Docker host where Git backups are stored.
# Backups remain ordinary, directly accessible files if the container is removed.
BACKUP_HOST_PATH=/mnt/storage/github-backups

# Web interface port on the host.
APP_PORT=8787

# Bind to loopback unless you have a specific, protected network design.
APP_BIND_ADDRESS=127.0.0.1

# For an Internet-facing installation, set the canonical HTTPS origin and the
# exact proxy IP/CIDR that is allowed to supply X-Forwarded-* headers.
# PUBLIC_URL=https://backmygit.example.com
# ALLOWED_HOSTS=backmygit.example.com
# TRUSTED_PROXIES=172.20.0.0/16
# FORCE_HTTPS=true

# Session inactivity and absolute lifetimes in milliseconds.
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=43200000

# Published image. Pin a release tag for reproducible installations.
BACKMYGIT_IMAGE=drakonis96/backmygit:v0.2.0

# Background Git jobs allowed at once. Jobs for the same branch never overlap.
WORKER_CONCURRENCY=2

# Concurrent cloud transfers and maximum attempts per transfer.
TRANSFER_CONCURRENCY=2
TRANSFER_MAX_ATTEMPTS=5
RCLONE_TIMEOUT_MS=3600000

# Keep private/custom-network S3 endpoints disabled unless they are intentional
# and protected by outbound firewall policy.
ALLOW_PRIVATE_CLOUD_ENDPOINTS=false

# Refuse new jobs when the backup filesystem has less free space than this (512 MiB).
MIN_FREE_BYTES=536870912

# Maximum time for one Git command, in milliseconds (30 minutes).
GIT_TIMEOUT_MS=1800000

APP_VERSION=0.2.0
